median_acc = median(accuracy, na.rm = TRUE),
.groups = "drop"
) %>%
filter(n_languages >= 5) %>%
arrange(desc(mean_acc))
print(family_stats)
script_stats <- df_merged %>%
group_by(Script) %>%
summarise(
n_languages = n_distinct(ISO_639),
mean_acc = mean(accuracy, na.rm = TRUE),
median_acc = median(accuracy, na.rm = TRUE),
.groups = "drop"
) %>%
arrange(desc(n_languages))
print(script_stats)
# Speaker counts span multiple orders of magnitude; calculate log10 scale
df_merged <- df_merged %>%
mutate(log10_L1 = log10(L1_Users + 1))
# Spearman & Pearson correlation between L1 speaker counts and accuracy
l1_correlation <- df_merged %>%
filter(!is.na(L1_Users)) %>%
summarise(
spearman_corr = cor(log10_L1, accuracy, method = "spearman"),
pearson_corr = cor(log10_L1, accuracy, method = "pearson")
)
print(l1_correlation)
# Group L1 Users into ordinal bins for tabular presentation
df_merged <- df_merged %>%
mutate(
L1_Bin = case_when(
L1_Users == 0 ~ "0 (Extinct)",
L1_Users < 1e4 ~ "< 10K",
L1_Users < 1e6 ~ "10K - 1M",
L1_Users < 1e7 ~ "1M - 10M",
TRUE ~ "> 10M"
),
L1_Bin = factor(L1_Bin, levels = c("0 (Extinct)", "< 10K", "10K - 1M", "1M - 10M", "> 10M"))
)
l1_bin_stats <- df_merged %>%
group_by(L1_Bin) %>%
summarise(
n_languages = n_distinct(ISO_639),
mean_acc = mean(accuracy, na.rm = TRUE),
median_acc = median(accuracy, na.rm = TRUE),
.groups = "drop"
)
print(l1_bin_stats)
model_egids_interaction <- df_merged %>%
group_by(model, EGIDS_level) %>%
summarise(
mean_acc = mean(accuracy, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(names_from = EGIDS_level, values_from = mean_acc)
print(model_egids_interaction)
# Define target ISO language codes
target_langs <- c("eng", "cmn", "fra", "spa")
task_lang_acc <- df_merged %>%
# Filter for target model and target languages
filter(model == "mistral-small-3.2", ISO_639 %in% target_langs) %>%
group_by(task, ISO_639) %>%
summarise(
mean_accuracy = mean(accuracy, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_wider(
names_from = ISO_639,
values_from = mean_accuracy
)
print(task_lang_acc)
library(ggplot2)
egids_model_trend <- df_merged %>%
filter(!is.na(EGIDS_level)) %>%
group_by(model, EGIDS_level) %>%
summarise(mean_acc = mean(accuracy, na.rm = TRUE), .groups = "drop")
ggplot(egids_model_trend, aes(x = EGIDS_level, y = mean_acc, color = model, group = model)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
geom_text(aes(label = sprintf("%.3f", mean_acc)), vjust = -0.8, size = 3.5, show.legend = FALSE) +
scale_color_brewer(palette = "Set1") +
scale_y_continuous(limits = c(0.4, 1.0), expand = expansion(mult = c(0.05, 0.15))) +
theme_minimal() +
theme(
legend.position = "bottom",
axis.text.x = element_text(size = 10, face = "bold"),
plot.title = element_text(face = "bold", size = 14)
) +
labs(
title = "Model Performance Trajectory Across EGIDS Levels",
subtitle = "Interaction analysis: Model vs Language Vitality Level",
x = "EGIDS Level",
y = "Mean Accuracy",
color = "Model"
)
# Heatmap: Model vs Task Mean Accuracy
ggplot(model_task_stats, aes(x = task, y = model, fill = mean_acc)) +
geom_tile(color = "white", linewidth = 0.8) +
geom_text(aes(label = sprintf("%.2f", mean_acc)), color = "black", size = 3.5, fontface = "bold") +
scale_fill_gradient2(low = "#d73027", mid = "#fee08b", high = "#1a9850", midpoint = 0.7, name = "Mean Acc") +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1, size = 10),
panel.grid = element_blank(),
plot.title = element_text(face = "bold", size = 14)
) +
labs(
title = "Model Accuracy Across LLM Tasks",
x = "Task",
y = "Model"
)
# Boxplot: Dls_Level vs Accuracy faceted by Model
df_merged %>%
filter(!is.na(Dls_Level)) %>%
ggplot(aes(x = Dls_Level, y = accuracy, fill = Dls_Level)) +
geom_boxplot(outlier.alpha = 0.2, alpha = 0.7) +
facet_wrap(~ model) +
scale_fill_brewer(palette = "Spectral") +
theme_minimal() +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 30, hjust = 1),
plot.title = element_text(face = "bold", size = 14)
) +
labs(
title = "Accuracy Distribution Across Digital Language Support Levels",
x = "Digital Language Support (Dls Level)",
y = "Accuracy"
)
library(jsonlite)  # only used indirectly; input_key kept as raw JSON string
# Canonical task order (mirrors the rest of the report)
task_order <- c("spelling", "inverse_spelling", "contains_character", "contains_word",
"orthographic_similarity", "character_insertion", "word_insertion",
"character_deletion", "word_deletion", "character_substitution",
"word_substitution", "character_swapping", "word_swapping")
# Read all English x Mistral log files
log_files <- list.files("eng",
pattern = "result_eng_Latn_.*_mistral-small-3\\.2\\.csv$",
full.names = TRUE)
logs <- log_files %>%
map_dfr(~ read_csv(.x, show_col_types = FALSE))
glimpse(logs)
# Per-task summary: accuracy and how many wrong items are API errors vs substantive
task_summary <- logs %>%
group_by(task) %>%
summarise(
n                   = n(),
accuracy            = round(mean(is_correct), 3),
n_wrong             = sum(is_correct == 0),
n_api_error_wrong   = sum(is_correct == 0 & is_api_error == 1),
n_substantive_wrong = sum(is_correct == 0 & is_api_error == 0),
.groups = "drop"
) %>%
mutate(task = factor(task, levels = task_order)) %>%
arrange(task)
print(task_summary)
task_order <- c("spelling", "inverse_spelling", "contains_character", "contains_word",
"orthographic_similarity", "character_insertion", "word_insertion",
"character_deletion", "word_deletion", "character_substitution",
"word_substitution", "character_swapping", "word_swapping")
logs <- list.files("eng", pattern = "result_eng_Latn_.*_mistral-small-3\\.2\\.csv$",
full.names = TRUE) %>%
map_dfr(~ read_csv(.x, show_col_types = FALSE))
set.seed(42)
mistakes <- logs %>%
filter(is_correct == 0, is_api_error == 0) %>%   # real mistakes, not API errors
group_by(task) %>%
slice_sample(n = 5) %>%
ungroup() %>%
mutate(task = factor(task, levels = task_order)) %>%
arrange(task) %>%
select(task, input = input_key, expected, model_output)
write_csv(mistakes, "english_mistral_mistakes.csv")
print(mistakes, n = nrow(mistakes))
